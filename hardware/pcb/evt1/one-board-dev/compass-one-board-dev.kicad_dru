(version 1)

# The unmodified USB4105 vendor land pattern sets its internal locating-hole
# clearance. All other checks retain the 0.25 mm hole-to-copper margin.
(rule "General hole-to-copper clearance"
    (condition "A.Reference != 'J110' || B.Reference != 'J110'")
    (constraint hole_clearance (min 0.25mm)))
