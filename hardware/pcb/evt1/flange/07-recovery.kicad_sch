  (global_label "MODE_N" (shape input) (at 314.96 68.58 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid 76b919da-f872-5af8-9df7-691156c22de1))
  (text
    "GPIO1 POWER_N is a diode-OR of the physical switch and active-low dock presence.\nWhile docked, firmware must suppress GPIO1 button gestures and deep sleep.\nU71 watches the separate raw physical switch, so docking never starts its timer."
    (at 40.64 132.08 0)
    (effects (font (size 1.524 1.524)) (justify left top))
    (uuid 900164b3-8ba4-5a38-9c9f-504ee5d3a90e))
  (text
    "Hold Power >=7.5 s for an independent 400 ms EN reset. Release before retry.\nHold Mode low during that reset for ROM USB download through the four contacts.\nInternal EN/BOOT service pads remain available before molding. No dock reset pin required."
    (at 40.64 165.1 0)
    (effects (font (size 1.524 1.524)) (justify left top))
    (uuid 0cf59463-8112-5ff3-b6bf-79ee4abc52c7))
