  (footprint "PackPigtailR35:Pack_Pigtail_4Net_5Land" (layer "B.Cu")
    (tstamp 4a98ec89-059c-4222-a887-a933ccba3aa9)
    (at 102.5 102.205)
    (descr "Four-net five-land soldered pack interface; two distinct GND pad2 lands; no populated header or paste")
    (property "AssemblyDomain" "MAIN_T")
    (property "DesignStatus" "CANDIDATE — NOT RELEASED")
    (property "Footprint" "PackPigtailR35:Pack_Pigtail_4Net_5Land")
    (property "ReviewNote" "Copper-only hand-solder interface; do not populate the former Pico-Lock header. Original logical pins1PACK_P,2GND,3PACK_NTC,4PACK_GUARD preserved. Two distinct pad2 lands: original2P power return; new2S at mechanicalXY[-2.2,41.9] for separate NTC return. Join returns only on body PCB. Actual wire, solder/strain relief/loading qualification required; batteryOPEN.")
