  (global_label "GND" (shape input) (at 266.7 101.6 180) (effects (font (size 1.016 1.016)) (justify right)) (uuid 00d6e563-ebb3-5829-81aa-ac494819d39b))
  (text
    "GPIO10 drives tip and diagnostic pack dividers; pulse only for settled conversions.\nAIN0 = tip, AIN1 = half excitation, AIN2 = pack monitor, AIN3 = GND.\nR = 10 kΩ × input / (2 × AIN1 − input), using bracketing reference reads.\nHardware charge limits stay on the independent BQ24074 TS and comparator sensor pairs.\nOpen/short/unavailable readings are invalid. Pack monitor grants no charge permission."
    (at 40.64 205.74 0)
    (effects (font (size 1.524 1.524)) (justify left top))
    (uuid 3064acb5-53fc-58d2-9f6f-53734e950581)))
