  (text
    "Native USB: D- to GPIO18, D+ to GPIO19. Place R75/R76 near MCU.\nContact order from -X: GND / D- / D+ / 5V. Place U75 at contact entry.\nInternal J4 is before series resistors; do not connect two USB hosts simultaneously."
    (at 35.56 132.08 0)
    (effects (font (size 1.524 1.524)) (justify left top))
    (uuid c35ed0a7-9d1e-5e57-b899-bd8ff2582890)))
