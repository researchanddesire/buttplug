      "fix": "One high/low WDI pulse per completed healthy loop;100ms work limit plus10ms cadence stays below170ms watchdog minimum"
    },
    {
      "issue": "Post-cut rail is absent before UV_RUN and may still be rising immediately after it",
      "fix": "Check PB2 digital presence after300ms start grace, alongside LED current/voltage; no analog4.3V measurement claimed"
    },
    {
      "issue": "Fault acknowledgement release could precede420ms UV supervisor recovery",
      "fix": "Require500ms continuously healthy inputs before accepting a fresh acknowledgement press"
    },
    {
      "issue": "Compiler-dependent busy delay inflated LCD full-frame runtime",
      "fix": "Use SysTick core-clock counting for conservative bus delays; scope/loop timing remains a hardware gate"
    },
    {
      "issue": "Previous J302 reversal double-flipped the installed LCD contact order",
      "fix": "Manufacturer topview pin1left/mouthdown matches unrotated nativefootprint after boardy-to-dockminusY mapping; direct1:1 mate preserves LCDpin1-X after X-axis fold"
    }
